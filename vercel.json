{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "env -u npm_config_cache_dir -u NPM_CONFIG_CACHE_DIR npm ci --no-audit --no-fund",
  "buildCommand": "env -u npm_config_cache_dir -u NPM_CONFIG_CACHE_DIR sh -c 'npm run check:pilot && npm run build'",
  "regions": ["syd1"],
  "functions": {
    "src/app/api/**/*.ts": { "maxDuration": 60 }
  }
}
